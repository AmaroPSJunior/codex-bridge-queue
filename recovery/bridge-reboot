#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail

RECOVER="$HOME/.local/bin/bridge-recover"
REPO="https://github.com/AmaroPSJunior/codex-bridge-queue.git"

fail(){ printf 'bridge-reboot: %s\n' "$*" >&2; exit 1; }
pids(){ pgrep -f "$1" 2>/dev/null || true; }

[ -x "$RECOVER" ] || fail "bridge-recover não instalado"

printf '[1/4] Encerrando supervisores e workers...\n'
# Stop every known supervisor generation first. Killing only its worker lets the
# supervisor immediately recreate it and races the recovery controller.
for pattern in '[s]upabase-launcher\.py' '[s]upabase-worker\.js'; do
  for pid in $(pids "$pattern"); do
    kill -TERM "$pid" 2>/dev/null || true
  done
done

# Require a stable zero-worker/zero-supervisor window before recovery. This
# catches boot/legacy supervisors that recreate a worker after the first TERM.
stable=0
for _ in $(seq 1 45); do
  if [ -z "$(pids '[s]upabase-launcher\.py')" ] && [ -z "$(pids '[s]upabase-worker\.js')" ]; then
    stable=$((stable + 1))
    [ "$stable" -ge 3 ] && break
  else
    stable=0
    for pattern in '[s]upabase-launcher\.py' '[s]upabase-worker\.js'; do
      for pid in $(pids "$pattern"); do kill -TERM "$pid" 2>/dev/null || true; done
    done
  fi
  sleep 1
done
[ "$stable" -ge 3 ] || fail "supervisor/worker continua reiniciando; recuperação abortada com segurança"

printf '[2/4] Atualizando controlador independente...\n'
mkdir -p "$HOME/.cache"
tmp="$(mktemp -d "$HOME/.cache/bridge-reboot.XXXXXX")"
trap 'rm -rf "$tmp"' EXIT
git clone --quiet --depth=1 --branch main "$REPO" "$tmp/repo"
python3 "$tmp/repo/recovery/bridge-recover.py" install >/dev/null

printf '[3/4] Preparando, validando e promovendo slot A/B...\n'
"$RECOVER" recover

printf '[4/4] Verificando estado final...\n'
"$RECOVER" status
