#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail

RECOVER="$HOME/.local/bin/bridge-recover"
REPO="https://github.com/AmaroPSJunior/codex-bridge-queue.git"

fail(){ printf 'bridge-reboot: %s\n' "$*" >&2; exit 1; }
pids(){ pgrep -f "$1" 2>/dev/null || true; }

[ -x "$RECOVER" ] || fail "bridge-recover não instalado"

printf '[1/4] Encerrando boot legado, supervisores e workers...\n'
# A legacy Termux:Boot process may still be sleeping and can relaunch the old
# checkout after the first drain. Stop any in-flight boot entrypoint first.
for pid in $(pids '[.]termux/boot/20-codex-bridge'); do
  [ "$pid" = "$" ] || kill -TERM "$pid" 2>/dev/null || true
done
# Stop every known supervisor generation first. Killing only its worker lets the
# supervisor immediately recreate it and races the recovery controller.
for pattern in '[w]watchdog/watchdog.py --serve' '[c]ontrol-bootstrap\.py' '[s]upabase-launcher\.py' '[s]upabase-worker\.js'; do
  for pid in $(pids "$pattern"); do
    kill -TERM "$pid" 2>/dev/null || true
  done
done

# Require a stable zero-worker/zero-supervisor window before recovery. This
# catches boot/legacy supervisors that recreate a worker after the first TERM.
# Avoid deeply nested command substitutions: verify that every generation exited.
all_stopped() {
  for pattern in '[w]atchdog/watchdog.py --serve' '[.]termux/boot/20-codex-bridge' '[c]ontrol-bootstrap\.py' '[s]upabase-launcher\.py' '[s]upabase-worker\.js'; do
    if [ -n "$(pids "$pattern")" ]; then return 1; fi
  done
  return 0
}
stable=0
for _ in $(seq 1 45); do
  if all_stopped; then
    stable=$((stable + 1))
    [ "$stable" -ge 3 ] && break
  else
    stable=0
    for pattern in '[w]atchdog/watchdog.py --serve' '[c]ontrol-bootstrap\.py' '[s]upabase-launcher\.py' '[s]upabase-worker\.js'; do
      for pid in $(pids "$pattern"); do kill -TERM "$pid" 2>/dev/null || true; done
    done
  fi
  sleep 1
done
[ "$stable" -ge 3 ] || fail "supervisor/worker continua reiniciando; recuperação abortada com segurança"

printf '[2/4] Atualizando controlador independente...\n'
mkdir -p "$HOME/.cache"
tmp="$(mktemp -d "$HOME/.cache/bridge-reboot.XXXXXX")"
trap 'rm -rf "$tmp"' EXIT
git clone --quiet --depth=1 --branch main "$REPO" "$tmp/repo"
python3 "$tmp/repo/recovery/bridge-recover.py" install >/dev/null

printf '[3/4] Preparando, validando e promovendo slot A/B...\n'
"$RECOVER" recover

printf '[4/4] Verificando estado final...\n'
"$RECOVER" status
